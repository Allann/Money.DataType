{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Showcase: API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare showcase API",
      "program": "${workspaceFolder}/showcase/Hs.Showcase.Api/bin/Debug/net10.0/Hs.Showcase.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/showcase/Hs.Showcase.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar"
      }
    },
    {
      "name": "Showcase: React UI (API required)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/showcase/web",
      "preLaunchTask": "start showcase React app"
    }
  ],
  "compounds": [
    {
      "name": "Showcase: React app",
      "configurations": [
        "Showcase: API",
        "Showcase: React UI (API required)"
      ],
      "stopAll": true
    }
  ]
}
