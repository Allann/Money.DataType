{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare showcase API",
      "dependsOn": [
        "stop existing showcase API",
        "build showcase API"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "stop existing showcase API",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/stop-showcase-api.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "build showcase API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/showcase/Hs.Showcase.Api/Hs.Showcase.Api.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "start showcase React app",
      "type": "npm",
      "script": "dev",
      "path": "showcase/web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> hs-showcase-web@.* dev$",
          "endsPattern": "Local:.*http://localhost:5173/"
        }
      }
    }
  ]
}
