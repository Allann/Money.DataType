<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Code quality">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Code-quality rules at "recommended"; style rules only where .editorconfig says so. -->
    <AnalysisLevelStyle>latest-default</AnalysisLevelStyle>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Allan Nielsen</Authors>
    <Company>Hybrid Solution</Company>
    <Copyright>Copyright © 2020-$([System.DateTime]::UtcNow.Year) Allan Nielsen</Copyright>
    <RepositoryUrl>https://github.com/Allann/Money.DataType</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
